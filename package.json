{
  "name": "@ylq77147/dsh-skin-plugin",
  "version": "0.3.0",
  "description": "Safe synchronized component skins and a visual theme studio for DeepSeek Harness WebUI",
  "author": "ylq77147",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylqit/dsh-skin-plugin.git"
  },
  "homepage": "https://github.com/ylqit/dsh-skin-plugin#readme",
  "bugs": {
    "url": "https://github.com/ylqit/dsh-skin-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-skin": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "builtins",
    "guides",
    "cordis.patch.yml",
    "README.md",
    "templates"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "skin:create": "node lib/cli.js create",
    "skin:pack": "node lib/cli.js pack",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/check-contract.mjs",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-modules": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.1.0-rc.7",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-modules": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  }
}
