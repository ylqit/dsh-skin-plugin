{
  "name": "@deepseek-ai/dsh-skin-plugin",
  "version": "0.1.0",
  "description": "Safe synchronized component skins and a visual theme studio for DeepSeek Harness WebUI",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-skin": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./invariant": "./lib/invariant.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "builtins",
    "cordis.patch.yml",
    "README.md",
    "templates"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "skin:create": "node lib/cli.js create",
    "skin:pack": "node lib/cli.js pack",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5 <0.2",
    "@deepseek-ai/dsh-client-modules": ">=0.1.0-rc.5 <0.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5 <0.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5 <0.2",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.5 <0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5 <0.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5 <0.2",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-modules": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  }
}
